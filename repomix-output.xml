    const fullHtml = `<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>سؤال - أكاديمية عقدة</title>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@500;700;800;900&display=swap" rel="stylesheet">
</head>
<body style="background:#eae6df; padding:24px; margin:0; display:flex; justify-content:center; font-family:'Tajawal',sans-serif;">
  <div style="width:100%; max-width:680px;">
    ${innerMarkup}
  </div>
</body>
</html>`;
    navigator.clipboard.writeText(fullHtml);
    setCopiedCode(true);
    setTimeout(() => setCopiedCode(false), 2000);
