                  <g fill={t.doodleColor} stroke={t.doodleColor} fontFamily="serif" fontSize="22">
                    <text x="110" y="65" stroke="none">= ln x</text>
                    <text x="450" y="75" stroke="none">.. = tan</text>
                    <text x="720" y="210" stroke="none">2R</text>
                    <text x="610" y="520" stroke="none" fontSize="28">tan</text>
                    <text x="640" y="560" stroke="none">E = mc²</text>
                    <text x="690" y="625" stroke="none">sin</text>
                    <text x="690" y="655" stroke="none">cos</text>
                    <text x="15" y="370" stroke="none">in</text>
                    <text x="5" y="405" stroke="none">cos</text>
                    <text x="150" y="595" stroke="none" fontSize="28">%</text>
                    <text x="15" y="605" stroke="none" fontSize="28">π</text>
                    <text x="165" y="535" stroke="none">E =</text>
                    <polygon points="240,35 290,90 215,90" fill="none" strokeWidth="2" />
                    <polygon points="680,600 745,675 655,675" fill="none" strokeWidth="2" />
                    <polygon points="735,445 795,420 795,520" fill="none" strokeWidth="2" />
                    <path d="M 35,515 Q 70,515 85,550 L 35,550 Z" fill="none" strokeWidth="2" />
                  </g>
                </svg>

                {/* الموجة العلوية */}
                <svg
                  viewBox="0 0 800 135"
                  style={{
                    position: 'absolute',
                    top: 0,
                    left: 0,
                    width: '100%',
                    height: '115px',
                    pointerEvents: 'none',
                  }}
                  preserveAspectRatio="none"
                >
                  <path
                    d="M 0,32 Q 210,-15 470,22 Q 650,120 800,88 L 800,0 L 0,0 Z"
                    fill={t.waveSub}
                    opacity="0.65"
                  />
                  <path
                    d="M 0,24 Q 230,-18 480,15 Q 660,110 800,82 L 800,58 Q 660,85 490,0 L 0,0 Z"
                    fill={t.waveTop}
                  />
                </svg>

                {/* الشعار في أعلى اليمين */}
                <div
                  style={{
                    position: 'relative',
                    zIndex: 2,
                    display: 'flex',
                    justifyContent: 'flex-start',
                    alignItems: 'flex-start',
                    marginTop: '6px',
                  }}
                >
                  {customLogo ? (
                    <img
                      src={customLogo}
                      alt="أكاديمية عقدة"
                      style={{ width: '92px', height: '92px', objectFit: 'contain' }}
                    />
                  ) : (
                    <UqdahLogo size={90} />
                  )}
                </div>

                {/* الدائرة الصفراء لاسم المادة */}
                <div
                  style={{
                    position: 'relative',
                    zIndex: 3,
                    display: 'flex',
                    justifyContent: 'center',
                    marginTop: '-32px',
                    marginBottom: '-42px',
                  }}
                >
                  <div
                    style={{
                      width: '94px',
                      height: '94px',
                      borderRadius: '50%',
                      backgroundColor: '#FCE052',
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'center',
                      fontWeight: 800,
                      fontSize: '32px',
                      color: '#FFFFFF',
                      textShadow: '0 1px 2px rgba(0,0,0,0.12)',
                      boxShadow: '0 4px 12px rgba(0,0,0,0.06)',
                    }}
                  >
                    {subject || 'احياء'}
                  </div>
                </div>

                {/* الصندوق الرئيسي للسؤال والخيارات والربط */}
                <div
                  style={{
                    position: 'relative',
                    zIndex: 2,
                    backgroundColor: t.cardBg,
                    border: `1.8px solid ${t.border}`,
                    borderRadius: '28px',
                    padding: '46px 28px 20px',
                    boxSizing: 'border-box',
                  }}
                >
                  <div
                    style={{
                      textAlign: 'center',
                      fontWeight: 800,
                      fontSize: '24px',
                      color: '#2B1810',
                      lineHeight: 1.45,
                    }}
                  >
                    {questionText && <div>{questionText}</div>}
                    {questionImage && (
                      <div style={{ marginTop: '10px', display: 'flex', justifyContent: 'center' }}>
                        <img
                          src={questionImage}
                          alt="صورة السؤال"
                          style={{ maxHeight: '175px', borderRadius: '10px', objectFit: 'contain' }}
                        />
                      </div>
                    )}
                  </div>

                  {activeOptions.length > 0 && (
                    <div
                      style={{
                        display: 'grid',
                        gridTemplateColumns: activeOptions.length === 1 ? '1fr' : 'repeat(2, 1fr)',
                        gap: '14px 18px',
                        marginTop: '16px',
                      }}
                    >
                      {activeOptions.map((opt, index) => {
                        const isCorrect = highlightCorrectAnswer && rightAnswer === opt.id;
                        const isThirdOfThree = activeOptions.length === 3 && index === 2;
                        return (
                          <div
                            key={opt.id}
                            style={{
                              gridColumn: isThirdOfThree ? '1 / -1' : undefined,
                              maxWidth: isThirdOfThree ? '50%' : undefined,
                              margin: isThirdOfThree ? '0 auto' : undefined,
                              width: '100%',
                              display: 'flex',
                              alignItems: 'center',
                              border: `1.8px solid ${isCorrect ? '#8CE0B0' : t.border}`,
                              backgroundColor: isCorrect ? '#B6F2CF' : '#FFFFFF',
                              borderRadius: '11px',
                              padding: '7px 12px',
                              gap: '10px',
                              minHeight: '46px',
                              boxSizing: 'border-box',
                            }}
                          >
                            <span
                              style={{
                                width: '28px',
                                height: '28px',
                                borderRadius: '50%',
                                backgroundColor: isCorrect ? '#90C4A5' : '#E5A5AE',
                                color: '#ffffff',
                                display: 'inline-flex',
                                alignItems: 'center',
                                justifyContent: 'center',
                                fontWeight: 800,
                                fontSize: '15px',
                                flexShrink: 0,
                              }}
                            >
                              {arabicLabels[index] || opt.label}
                            </span>
                            <div
                              style={{
                                flex: 1,
                                textAlign: 'center',
                                fontWeight: 800,
                                fontSize: '19px',
                                color: '#1E1815',
                                lineHeight: 1.3,
                              }}
                            >
                              {opt.text && <div>{opt.text}</div>}
                              {opt.image && (
                                <img
                                  src={opt.image}
                                  alt=""
                                  style={{
                                    maxHeight: '70px',
                                    margin: '4px auto 0',
                                    display: 'block',
                                    borderRadius: '6px',
                                    objectFit: 'contain',
                                  }}
                                />
                              )}
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  )}

                  {hasMnemonicText && (
                    <div
                      style={{
                        marginTop: '16px',
                        backgroundColor: '#F3C6CB',
                        borderRadius: '14px',
                        padding: '8px 14px',
                        display: 'flex',
                        alignItems: 'center',
                        gap: '10px',
                      }}
                    >
                      <span
                        style={{
                          backgroundColor: '#E397A1',
                          color: '#ffffff',
                          padding: '2px 12px',
                          borderRadius: '999px',
                          fontSize: '14px',
                          fontWeight: 800,
                          flexShrink: 0,
                        }}
                      >
                        ربط
                      </span>
                      <div
                        style={{
                          flex: 1,
                          textAlign: 'center',
                          fontWeight: 800,
                          fontSize: '18px',
                          color: '#231815',
                        }}
                      >
                        {mnemonicText}
                      </div>
                    </div>
                  )}
                </div>

                {hasMnemonicMedia && (
                  <div
                    style={{
                      position: 'relative',
                      zIndex: 2,
                      marginTop: '4px',
                      display: 'flex',
                      justifyContent: 'center',
                    }}
                  >
                    {mnemonicMediaType === 'image' ? (
                      <img
                        src={mnemonicMediaUrl}
                        alt="ربط"
                        style={{
                          width: '285px',
                          maxHeight: '310px',
                          objectFit: 'cover',
                          display: 'block',
                        }}
                      />
                    ) : (
                      <video
                        src={mnemonicMediaUrl}
                        controls
                        style={{
                          width: '285px',
                          maxHeight: '310px',
                          objectFit: 'cover',
                          display: 'block',
                        }}
                      />
                    )}
                  </div>
                )}
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>
  );
}
</file>

