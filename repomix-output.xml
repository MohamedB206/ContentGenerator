  const handleFileUpload = (file, callback) => {
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (e) => callback(e.target.result);
    reader.readAsDataURL(file);
  };

  const updateOption = (id, patch) => {
    setOptions((prev) => prev.map((o) => (o.id === id ? { ...o, ...patch } : o)));
  };

  const setQuickOptionCount = (count) => {
    setOptions((prev) =>
      prev.map((opt, idx) => ({
        ...opt,
        enabled: idx < count,
      }))
    );
  };

  const handleAddSubject = (e) => {
    e.preventDefault();
    const trimmed = newSubjectInput.trim();
    if (trimmed && !subjects.includes(trimmed)) {
      setSubjects([...subjects, trimmed]);
      setSubject(trimmed);
      setNewSubjectInput('');
    }
  };

  const resetQuestionFields = () => {
    setQuestionText('');
    setQuestionImage(null);
    setOptions([
      { id: 'A', label: 'أ', text: '', image: null, enabled: true },
      { id: 'B', label: 'ب', text: '', image: null, enabled: true },
      { id: 'C', label: 'ج', text: '', image: null, enabled: true },
      { id: 'D', label: 'د', text: '', image: null, enabled: true },
    ]);
    setMnemonicText('');
    setMnemonicMediaUrl(null);
    setMnemonicMediaType('none');
  };

  const themes = {
    cream: {
      bg: '#F8F5EC',
      waveTop: '#DE6E79',
      waveSub: '#F3C75F',
      cardBg: '#FCFBF7',
      border: '#9A4854',
      doodleColor: '#D8CFBE',
    },
    blush: {
      bg: '#FDF3F4',
      waveTop: '#C94A58',
      waveSub: '#F2C94C',
      cardBg: '#FFFFFF',
      border: '#9A4854',
      doodleColor: '#EBCBCE',
    },
    sand: {
      bg: '#F4EFE6',
      waveTop: '#B83B4A',
      waveSub: '#E6B84F',
      cardBg: '#FFFDF9',
      border: '#8B3A46',
      doodleColor: '#CEC4B0',
    },
  };

  const t = themes[selectedTemplate] || themes.cream;
  const arabicLabels = ['أ', 'ب', 'ج', 'د'];

  const activeOptions = options.filter(
    (o) => o.enabled && (o.text.trim() !== '' || o.image !== null)
  );
  const enabledCount = options.filter((o) => o.enabled).length;

  const hasMnemonicText = enableMnemonic && mnemonicText.trim() !== '';
  const hasMnemonicMedia = enableMnemonic && mnemonicMediaType !== 'none' && mnemonicMediaUrl;

  const copyHtmlCode = () => {
    if (!templateCardRef.current) return;
